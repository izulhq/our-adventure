+  border-radius: 6px 0 0 0;
+  background: rgb(255 255 255 / 0.8);
+  font-size: 10px;
+  color: var(--muted);
+}
+
+.place-popup .leaflet-popup-content-wrapper {
+  padding: 0;
+  overflow: hidden;
+  border: var(--line);
+  border-radius: 18px;
+  box-shadow: 4px 4px 0 var(--ink);
+}
+.place-popup .leaflet-popup-content {
+  margin: 0;
+  font-size: 14px;
+  line-height: 1.45;
+}
+.place-popup .leaflet-popup-tip-container {
+  margin-top: -2px;
+}
+.place-popup .leaflet-popup-tip {
+  border: var(--line);
+  box-shadow: none;
+}
+.place-popup a.leaflet-popup-close-button {
+  top: 10px;
+  right: 10px;
+  z-index: 1;
+  width: 30px;
+  height: 30px;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--paper);
+  color: var(--ink);
+  font: 700 18px/26px var(--font-sans);
+}
+.place-popup .place-photo img {
+  display: block;
+  width: 100%;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-bottom: var(--line);
+}
+.place-popup .place-body {
+  padding: 12px 16px 15px;
+}
+.place-popup .place-name {
+  padding-right: 28px;
+  font: 22px/1.05 var(--font-display);
+}
+.place-popup .place-photo + .place-body .place-name {
+  padding-right: 0;
+}
+.place-popup .place-note {
+  margin: 6px 0 0;
+}
+.place-popup .place-address {
+  margin: 6px 0 0;
+  font-size: 12px;
+  line-height: 1.4;
+  color: var(--muted);
+}
+.place-popup .place-who {
+  display: inline-block;
+  margin-top: 11px;
+  padding: 3px 10px 4px;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--who);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+/* ---------- admin dashboard ---------- */
+
+.dash {
+  display: grid;
+  grid-template-columns: 232px 1fr;
+  height: 100dvh;
+}
+.dash-side {
+  display: flex;
+  flex-direction: column;
+  gap: 28px;
+  padding: 22px 16px;
+  background: var(--ink);
+  color: var(--paper);
+}
+.dash-brand {
+  padding: 0 6px;
+  font: 26px/0.95 var(--font-display);
+}
+.dash-brand span {
+  display: block;
+  margin-top: 6px;
+  font: 600 13px var(--font-sans);
+  color: #b9b9c3;
+}
+.dash-nav {
+  display: grid;
+  gap: 6px;
+}
+.dash-nav button {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 10px 14px;
+  border: 2px solid transparent;
+  border-radius: 999px;
+  font-size: 15px;
+  font-weight: 700;
+  cursor: pointer;
+}
+.dash-nav button:hover {
+  border-color: var(--paper);
+}
+.dash-nav button[aria-current="page"] {
+  background: var(--paper);
+  color: var(--ink);
+  box-shadow: 3px 3px 0 #2ee86f;
+}
+.dash-nav button span {
+  font-size: 13px;
+  opacity: 0.7;
+}
+.dash-foot {
+  display: grid;
+  gap: 10px;
+  margin-top: auto;
+  padding: 0 8px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.dash-foot a,
+.dash-foot button {
+  text-align: left;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+  cursor: pointer;
+}
+
+.dash-main {
+  overflow: auto;
+  padding: 28px 32px 56px;
+}
+.dash-head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 22px;
+}
+.dash-head h1 {
+  font: clamp(28px, 4vw, 38px) / 1 var(--font-display);
+}
+.dash-head p {
+  margin-top: 6px;
+  font-size: 14px;
+  color: var(--muted);
+}
+.crumb {
+  margin-bottom: 6px;
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--muted);
+  text-decoration: underline;
+  text-underline-offset: 3px;
+  cursor: pointer;
+}
+
+.card {
+  padding: 18px 20px;
+  border: var(--line);
+  border-radius: 18px;
+  background: var(--paper);
+  box-shadow: var(--shadow);
+}
+.card h2 {
+  margin-bottom: 8px;
+  font: 20px/1.1 var(--font-display);
+}
+.card-flush {
+  padding: 0;
+  overflow: hidden;
+}
+.empty {
+  padding: 28px 20px;
+  font-size: 15px;
+  color: var(--muted);
+}
+
+.tiles {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+  margin-bottom: 22px;
+}
+.tile {
+  display: grid;
+  gap: 2px;
+  padding: 14px 16px 15px;
+  border-radius: 18px;
+  background: var(--c, var(--paper));
+  text-align: left;
+  font-size: 14px;
+  font-weight: 700;
+  cursor: pointer;
+  transition: transform 80ms, box-shadow 80ms;
+}
+.tile:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 4px 4px 0 var(--ink);
+}
+.tile-wish {
+  border-style: dashed;
+}
+.tile-n {
+  font: 34px/1 var(--font-display);
+}
+
+.overview-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
+  gap: 20px;
+}
+.map-card {
+  min-height: 360px;
+  padding: 0;
+  overflow: hidden;
+}
+.map-frame {
+  position: relative;
+  height: 100%;
+  min-height: 360px;
+  overflow: hidden;
+}
+.map-card .map-frame {
+  border-radius: 16px;
+}
+.map-pick {
+  display: grid;
+  grid-template-rows: 1fr auto auto;
+  gap: 14px;
+}
+.map-pick .map-frame {
+  min-height: 420px;
+  border: var(--line);
+  border-radius: 12px;
+}
+
+.list-tools {
+  display: flex;
+  align-items: flex-end;
+  gap: 18px;
+  margin-bottom: 18px;
+}
+.list-tools .grow {
+  flex: 1;
+  max-width: 420px;
+}
+.list-tools .duo {
+  margin-left: auto;
+  box-shadow: var(--shadow);
+}
+
+.rows li + li {
+  border-top: 2px solid var(--ink);
+}
+.card:not(.card-flush) .rows li + li {
+  border-top-style: dashed;
+}
+.row {
+  display: grid;
+  grid-template-columns: 52px minmax(0, 1.4fr) 92px minmax(0, 1fr);
+  align-items: center;
+  gap: 16px;
+  width: 100%;
+  padding: 12px 18px;
+  text-align: left;
+  cursor: pointer;
+}
+.row:hover {
+  background: var(--wash);
+}
+.rows-compact .row {
+  grid-template-columns: 44px minmax(0, 1fr);
+  padding: 10px 0;
+}
+.rows-compact .row:hover {
+  background: none;
+}
+.rows-compact .row:hover .row-name {
+  text-decoration: underline;
+}
+.thumb {
+  position: relative;
+  display: grid;
+  place-items: center;
+  aspect-ratio: 1;
+  overflow: hidden;
+  border: var(--line);
+  border-radius: 12px;
+  background: var(--c);
+  font: 18px var(--font-display);
+}
+.thumb img {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.row-main {
+  display: grid;
+  gap: 2px;
+  min-width: 0;
+}
+.row-name {
+  font: 17px/1.15 var(--font-display);
+}
+.row-note,
+.row-address {
+  overflow: hidden;
+  font-size: 13px;
+  line-height: 1.4;
+  color: var(--muted);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.who {
+  justify-self: start;
+  padding: 3px 10px 4px;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--who);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.edit-grid {
+  display: grid;
+  grid-template-columns: minmax(320px, 460px) minmax(0, 1fr);
+  align-items: start;
+  gap: 20px;
+}
+.edit-actions {
+  position: sticky;
+  bottom: 0;
+  grid-column: 1 / -1;
+  display: flex;
+  gap: 10px;
+  padding: 14px 0 4px;
+  background: var(--wash);
+}
+.editor-hint {
+  font-size: 14px;
+  line-height: 1.5;
+  color: var(--muted);
+}
+
+.login {
+  display: grid;
+  place-items: center;
+  min-height: 100dvh;
+  padding: 16px;
+}
+.login-card {
+  width: min(380px, 100%);
+}
+.login-card h1 {
+  font: 34px/1 var(--font-display);
+}
+
+@media (max-width: 900px) {
+  .dash {
+    grid-template-columns: 1fr;
+    grid-template-rows: auto 1fr;
+  }
+  .dash-side {
+    flex-direction: row;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 12px 16px;
+    padding: 12px 16px;
+  }
+  .dash-brand {
+    font-size: 21px;
+  }
+  .dash-brand span {
+    display: none;
+  }
+  .dash-nav {
+    order: 3;
+    display: flex;
+    width: 100%;
+    overflow-x: auto;
+  }
+  .dash-nav button {
+    flex: none;
+    gap: 8px;
+    padding: 7px 12px;
+  }
+  .dash-foot {
+    display: flex;
+    gap: 14px;
+    margin: 0 0 0 auto;
+    padding: 0;
+  }
+  .dash-main {
+    padding: 20px 16px 48px;
+  }
+  .tiles {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .overview-grid,
+  .edit-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .map-pick .map-frame {
+    min-height: 300px;
+  }
+  .list-tools {
+    flex-wrap: wrap;
+  }
+  .list-tools .duo {
+    margin-left: 0;
+  }
+  .row {
+    grid-template-columns: 48px minmax(0, 1fr) auto;
+    gap: 12px;
+    padding: 12px 14px;
+  }
+  .row-address {
+    display: none;
+  }
+}
+
+.field {
+  display: grid;
+  gap: 6px;
+}
+.field > span,
+.field-label {
+  font-size: 13px;
+  font-weight: 700;
+}
+.input {
+  width: 100%;
+  padding: 9px 12px;
+  border: var(--line);
+  border-radius: 10px;
+  background: var(--paper);
+  font: 15px/1.4 var(--font-sans);
+}
+.input:focus-visible {
+  outline: none;
+  box-shadow: 3px 3px 0 var(--focus);
+}
+
+.choices {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+.choice input {
+  position: absolute;
+  opacity: 0;
+  pointer-events: none;
+}
+.choice span {
+  display: inline-block;
+  padding: 7px 14px;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--paper);
+  font-size: 14px;
+  font-weight: 700;
+  cursor: pointer;
+}
+/* Checked: ink by default; the who's-been-here choices pass their color as --c */
+.choice input:checked + span {
+  background: var(--ink);
+  color: var(--paper);
+  box-shadow: 2px 2px 0 var(--ink);
+}
+.choice[style] input:checked + span {
+  background: var(--c);
+  color: var(--ink);
+}
+.choice input:focus-visible + span {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.photo-drop {
+  display: grid;
+  place-items: center;
+  gap: 8px;
+  min-height: 96px;
+  padding: 10px;
+  border: 2px dashed var(--ink);
+  border-radius: 14px;
+  font-size: 14px;
+  font-weight: 700;
+  text-align: center;
+  cursor: pointer;
+}
+.photo-drop:focus-within {
+  border-color: var(--focus);
+}
+.photo-drop img {
+  max-height: 160px;
+  border: var(--line);
+  border-radius: 10px;
+}
+.photo-drop input {
+  position: absolute;
+  opacity: 0;
+  width: 1px;
+}
+
+.text-link {
+  display: block;
+  text-align: left;
+  font-size: 15px;
+  font-weight: 600;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+  cursor: pointer;
+}
+
+.toast {
+  position: fixed;
+  top: 16px;
+  left: 50%;
+  z-index: 1001;
+  max-width: calc(100vw - 32px);
+  padding: 9px 16px;
+  border-radius: 999px;
+  transform: translateX(-50%);
+  font-size: 14px;
+  font-weight: 700;
+}
+.toast-error {
+  background: var(--heart);
+  color: var(--paper);
+}
