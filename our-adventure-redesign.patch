+  --ink: #000;
+  --paper: #fff;
+  --muted: #55555f;
+  --heart: #ff2e55;
+  --focus: #34d1ff;
+  --wash: #e9ebf3;
+  --line: 2px solid var(--ink);
+  --shadow: 3px 3px 0 var(--ink);
+}
+
+body {
+  background: var(--wash);
+  color: var(--ink);
+  font-family: var(--font-sans);
+  -webkit-font-smoothing: antialiased;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+/* ---------- building blocks ---------- */
+
+.sticker {
+  background: var(--paper);
+  border: var(--line);
+  box-shadow: var(--shadow);
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 9px 16px;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--paper);
+  box-shadow: var(--shadow);
+  color: var(--ink);
+  font: 700 14px/1 var(--font-sans);
+  cursor: pointer;
+  transition: transform 80ms, box-shadow 80ms;
+}
+.btn:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 4px 4px 0 var(--ink);
+}
+.btn:active {
+  transform: translate(2px, 2px);
+  box-shadow: 1px 1px 0 var(--ink);
+}
+.btn:disabled {
+  opacity: 0.5;
+  pointer-events: none;
+}
+.btn-ink {
+  background: var(--ink);
+  color: var(--paper);
+}
+.btn-heart {
+  color: var(--heart);
+}
+.icon-btn {
+  display: grid;
+  place-items: center;
+  width: 34px;
+  height: 34px;
+  flex: none;
+  border: var(--line);
+  border-radius: 999px;
+  background: var(--paper);
+  cursor: pointer;
+}
+
+/* ---------- home ---------- */
+
+.map {
+  position: absolute;
+  inset: 0;
+}
+
+.masthead {
+  position: absolute;
+  top: 16px;
+  left: 16px;
+  z-index: 1000;
+  padding: 10px 16px 11px;
+  border-radius: 14px;
+  transform: rotate(-2.5deg);
+  transform-origin: top left;
+}
+.masthead h1 {
+  font: clamp(26px, 7vw, 40px) / 0.95 var(--font-display);
+  letter-spacing: -0.01em;
+}
+.masthead p {
+  margin-top: 5px;
+  font-size: 13px;
+  color: var(--muted);
+}
+
+.top-actions {
+  position: absolute;
+  top: 16px;
+  right: 16px;
+  z-index: 1000;
+  display: flex;
+  gap: 8px;
+}
+
+.alert {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  z-index: 1000;
+  width: min(360px, calc(100vw - 32px));
+  padding: 16px 18px;
+  border-radius: 16px;
+  transform: translate(-50%, -50%);
+  font-size: 15px;
+  line-height: 1.45;
+}
+.alert .btn {
+  margin-top: 12px;
+}
+
+/* ---------- the Venn ---------- */
+
+.duo-float {
+  position: absolute;
+  left: 16px;
+  bottom: 24px;
+  z-index: 1000;
+}
+
+.duo {
+  width: 216px;
+  padding: 8px 10px 6px;
+  border-radius: 20px;
+}
+.duo svg {
+  display: block;
+  width: 100%;
+  overflow: visible;
+}
+.duo-region {
+  cursor: pointer;
+  outline: none;
+}
+.duo-region path {
+  stroke: var(--ink);
+  stroke-width: 2.5;
+  stroke-linejoin: round;
+  transition: fill 150ms;
+}
+.duo-region:focus-visible path {
+  stroke: var(--focus);
+  stroke-width: 4;
+}
+.duo-region text {
+  text-anchor: middle;
+  pointer-events: none;
+}
+.duo-count {
+  font: 22px var(--font-display);
+}
+.duo-label {
+  font: 700 11px var(--font-sans);
+}
+.duo-region[aria-pressed="false"] text {
+  fill: #767676;
+}
+.duo figcaption {
+  margin-top: 2px;
+  text-align: center;
+  font-size: 12px;
+  color: var(--muted);
+}
+
+/* ---------- sheets (native <dialog>) ---------- */
+
+.sheet {
+  margin: auto;
+  padding: 0;
+  width: min(520px, calc(100vw - 32px));
+  max-height: calc(100dvh - 48px);
+  border: var(--line);
+  border-radius: 22px;
+  background: var(--paper);
+  color: var(--ink);
+  box-shadow: 6px 6px 0 var(--ink);
+}
+.sheet[open] {
+  animation: sheet-in 180ms ease-out;
+}
+.sheet::backdrop {
+  background: rgb(0 0 0 / 0.35);
+}
+.sheet-inner {
+  padding: 20px 22px 26px;
+}
+.sheet-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+}
+.sheet-head h2 {
+  font: 28px/1 var(--font-display);
+  padding-top: 3px;
+}
+@keyframes sheet-in {
+  from {
+    transform: translateY(14px);
+    opacity: 0;
   }
 }
+@media (max-width: 640px) {
+  .sheet {
+    margin: auto 0 0;
+    width: 100%;
+    max-width: 100%;
+    border-width: 2px 0 0;
+    border-radius: 22px 22px 0 0;
+    box-shadow: none;
+  }
+}
+
+.wish-list li {
+  padding: 14px 0;
+  border-top: 2px dashed var(--ink); /* dashed = not been yet, like the wishlist pins */
+}
+.wish-list li:first-child {
+  border-top: none;
+}
+.wish-list h3 {
+  font: 21px/1.1 var(--font-display);
+}
+.wish-list p {
+  margin-top: 4px;
+  font-size: 14px;
+  line-height: 1.45;
+  color: var(--muted);
+}
+.sheet-empty {
+  margin-top: 14px;
+  font-size: 15px;
+  color: var(--muted);
+}
+
+.about-cover {
+  display: block;
+  width: 100%;
+  margin: 16px 0 14px;
+  border: var(--line);
+  border-radius: 14px;
+}
+.about p {
+  max-width: 60ch;
+  font-size: 15px;
+  line-height: 1.6;
+}
+.about p + p {
+  margin-top: 10px;
+}
+.about-more {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  margin-top: 20px;
+  padding-top: 16px;
+  border-top: var(--line);
+}
+.about-more img {
+  width: 84px;
+  height: auto;
+}
+.about-more ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.about-more a {
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 3px;
+}
+
+/* ---------- pins ---------- */
+
+.pin {
+  background: none;
+  border: none;
+}
+.pin svg {
+  display: block;
+  overflow: visible;
+  filter: drop-shadow(2px 2px 0 var(--ink));
+}
+.pin text {
+  font: 11px var(--font-display);
+  text-anchor: middle;
+  fill: var(--ink);
+}
+.pin-drop {
+  transform-origin: 50% 100%;
+  animation: pin-drop 420ms cubic-bezier(0.2, 0.9, 0.3, 1.35) both;
+}
+@keyframes pin-drop {
+  from {
+    transform: translateY(-22px) scale(0.3);
+    opacity: 0;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .pin-drop,
+  .sheet[open] {
+    animation: none;
+  }
+}
+
+/* ---------- Leaflet overrides (Leaflet's own CSS loads first) ---------- */
+
+.leaflet-container {
+  background: var(--wash);
+  font-family: var(--font-sans);
+}
+.leaflet-container a {
+  color: inherit;
+}
+.leaflet-tile-pane {
+  filter: grayscale(1) sepia(0.15) hue-rotate(185deg) saturate(1.4) brightness(1.06) contrast(0.88);
+}
+.leaflet-marker-icon:focus-visible {
+  outline: none;
+}
+.leaflet-marker-icon:focus-visible svg path {
+  stroke: var(--focus);
+}
+
+.leaflet-touch .leaflet-bar {
+  border: none;
+  background: none;
+  box-shadow: none;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+.leaflet-touch .leaflet-bar a,
+.leaflet-touch .leaflet-bar a:first-child,
+.leaflet-touch .leaflet-bar a:last-child {
+  width: 40px;
+  height: 40px;
+  border: var(--line);
+  border-radius: 12px;
+  background: var(--paper);
+  box-shadow: var(--shadow);
+  color: var(--ink);
+  font: 24px/36px var(--font-display);
+}
+.leaflet-touch .leaflet-bar a:hover {
+  background: var(--paper);
+}
+.leaflet-right .leaflet-control-zoom {
+  margin: 0 16px 16px 0;
+}
+.leaflet-container .leaflet-control-attribution {
